<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SkaiDesktop.Core.Tests" />
    <Content Include="..\..\services\airllm\**\*" Link="airllm\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\services\diffusers\**\*" Link="diffusers\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Remove="artifacts\**" />
    <Compile Remove=".build\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <EmbeddedResource Remove=".build\**" />
    <None Remove="artifacts\**" />
    <None Remove=".build\**" />
    <PackageReference Include="Google.FlatBuffers" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="Porta.Pty" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="XTerm.NET" />
  </ItemGroup>
</Project>

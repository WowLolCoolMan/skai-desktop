{
  "name": "skai-desktop",
  "version": "0.1.4",
  "description": "Skai Desktop — a local-first Electron workspace for chat, coding, projects, and local AI models",
  "author": "Skai Desktop",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && node scripts/launch-electron.cjs\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "node scripts/launch-electron.cjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "monaco-editor": "^0.57.0",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "axe-core": "4.14.0",
    "electron": "latest",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.18"
    },
    "minimatch": "^11.0.1"
  }
}

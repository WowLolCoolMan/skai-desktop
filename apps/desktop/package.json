{
  "name": "skai-desktop",
  "version": "0.1.4",
  "description": "Skai Desktop — a local-first Electron workspace for chat, coding, projects, and local AI models",
  "author": "Skai Desktop",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && node scripts/launch-electron.cjs\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "node scripts/launch-electron.cjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.2.0",
    "@tesseract.js-data/eng": "1.0.0",
    "builder-util-runtime": "9.7.0",
    "electron-updater": "6.8.11",
    "pdfjs-dist": "6.5.438",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "4.7.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "concurrently": "10.0.7",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "wait-on": "9.5.1",
    "ws": "8.23.0"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.18"
    },
    "minimatch": "^11.0.1"
  }
}

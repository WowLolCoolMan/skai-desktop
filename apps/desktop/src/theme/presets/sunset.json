  "themes": [
    {
      "name": "Sunset Dark",
      "appearance": "dark",
      "colors": {
        "canvas": "#1a1020",
        "surface": "#22151f",
        "surface-raised": "#2c1b25",
        "border": "rgb(250 220 210 / 0.16)",
        "border-strong": "rgb(250 220 210 / 0.28)",
        "text": "#f7ece6",
        "text-muted": "#c7b0a6",

{
  "$schema": "../../../../../docs/theme.schema.json",
  "name": "Deep Sea",
  "author": "Skai Desktop",
  "license": "Original Skai Desktop theme (same license as the app)",
  "themes": [
    {
      "name": "Deep Sea Dark",
      "appearance": "dark",
      "colors": {
        "canvas": "#04121c",
        "surface": "#0a1b28",
        "surface-raised": "#0f2434",
        "border": "rgb(200 230 250 / 0.16)",
        "border-strong": "rgb(200 230 250 / 0.28)",
        "text": "#e3f2fa",
        "text-muted": "#96b6c9",
        "accent": "#38bdf8",
        "accent-strong": "#0ea5e9",
        "on-accent": "#031522",
        "sidebar": "#03101a",
        "sidebar-text": "#e3f2fa",
        "sidebar-strong": "#e3f2fa",
        "sidebar-muted": "#96b6c9",
        "sidebar-subtle": "#96b6c9",
        "sidebar-icon": "#96b6c9",
        "brand-mark": "#0ea5e9",
        "on-brand-mark": "#031522"
      },
      "gradients": {
        "canvas": {
          "gradient": "linear",
          "angle": 180,
          "stops": [
            {
              "color": "#04121c",
              "at": 0
            },
            {
              "color": "#062433",
              "at": 0.5
            },
            {
              "color": "#0a1830",
              "at": 1
            }
          ]

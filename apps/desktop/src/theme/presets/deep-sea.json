          ]
        },
        "primary-button": {
          "gradient": "linear",
          "angle": 120,
          "stops": [
            {
              "color": "#38bdf8",
              "at": 0
            },
            {
              "color": "#2dd4bf",
              "at": 1
            }
          ]
        },
        "brand-mark": {
          "gradient": "radial",
          "stops": [
            {
              "color": "#7dd3fc",
              "at": 0
            },
            {
              "color": "#0284c7",
              "at": 1
            }
          ]
        }
      }
    },

        "surface": "#111b2b",
        "surface-raised": "#172437",
        "border": "rgb(200 230 240 / 0.16)",
        "border-strong": "rgb(200 230 240 / 0.28)",
        "text": "#e6f1f5",
        "text-muted": "#a3b8c4",

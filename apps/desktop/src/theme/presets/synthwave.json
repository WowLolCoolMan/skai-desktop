          ]
        },
        "primary-button": {
          "gradient": "linear",
          "angle": 100,
          "stops": [
            {
              "color": "#a21caf",
              "at": 0
            },
            {
              "color": "#6d28d9",
              "at": 1
            }
          ]
        },
        "brand-mark": {
          "gradient": "conic",
          "angle": 0,
          "stops": [
            {
              "color": "#a21caf",
              "at": 0
            },
            {
              "color": "#6d28d9",
              "at": 0.5
            },
            {
              "color": "#a21caf",
              "at": 1
            }
          ]
        }

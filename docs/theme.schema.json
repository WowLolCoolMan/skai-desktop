{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skai-desktop:theme-schema:1",
  "title": "Skai Desktop theme family",
  "description": "Generated by scripts/theme-generate.cjs from the validator in apps/desktop/electron/theme-files.cjs. See docs/THEMING.md.",
  "type": "object",
  "required": [
    "name",
    "themes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "author": {
      "type": "string",
      "maxLength": 160
    },
    "license": {
      "type": "string",
      "maxLength": 160
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "name",
          "appearance"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "appearance": {
            "enum": [
              "light",
              "dark"
            ]
          },
          "colors": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "canvas": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-canvas"
              },
              "surface": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-surface"
              },
              "surface-raised": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-surface-raised"
              },
              "surface-soft": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-surface-soft"
              },
              "border": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-border"
              },
              "border-strong": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-border-strong"
              },
              "text": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-text"
              },
              "text-muted": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-text-muted"
              },
              "accent": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-accent"
              },
              "accent-strong": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-accent-strong"
              },
              "on-accent": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-on-accent"
              },
              "danger": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-danger"
              },
              "danger-text": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-danger-text"
              },
              "danger-strong": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-danger-strong"
              },
              "success": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-success"
              },
              "warning": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-warning"
              },
              "info": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-info"
              },
              "favorite": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-favorite"
              },
              "focus-ring": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-focus-ring"
              },
              "selection": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-selection"
              },
              "link": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-link"
              },
              "scrollbar-thumb": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-scrollbar-thumb"
              },
              "scrollbar-track": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-scrollbar-track"
              },
              "overlay": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-overlay"
              },
              "shadow": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-shadow"
              },
              "sidebar": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-sidebar"
              },
              "sidebar-text": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-sidebar-text"
              },
              "sidebar-strong": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-sidebar-strong"
              },
              "sidebar-muted": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-sidebar-muted"
              },
              "sidebar-subtle": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-sidebar-subtle"
              },
              "sidebar-icon": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-sidebar-icon"
              },
              "sidebar-hover": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-sidebar-hover"
              },
              "sidebar-history-hover": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-sidebar-history-hover"
              },
              "sidebar-active": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-sidebar-active"
              },
              "sidebar-active-border": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-sidebar-active-border"
              },
              "sidebar-border": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-sidebar-border"
              },
              "code-surface": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-code-surface"
              },
              "code-text": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-code-text"
              },
              "inline-code-text": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-inline-code-text"
              },
              "attachment-text": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-attachment-text"
              },
              "user-bubble": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-user-bubble"
              },
              "user-bubble-border": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-user-bubble-border"
              },
              "brand-mark": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-brand-mark"
              },
              "on-brand-mark": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-on-brand-mark"
              },
              "checker-a": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-checker-a"
              },
              "checker-b": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-checker-b"
              },
              "document-page": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-document-page"
              },
              "diff-added-surface": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-diff-added-surface"
              },
              "diff-added-text": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-diff-added-text"
              },
              "diff-removed-surface": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-diff-removed-surface"
              },
              "diff-removed-text": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-diff-removed-text"
              },
              "terminal-surface": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-terminal-surface"
              },
              "terminal-text": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-terminal-text"
              },
              "terminal-muted": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-color-terminal-muted"
              },
              "ansi-black": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-ansi-black"
              },
              "ansi-bright-black": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-ansi-bright-black"
              },
              "ansi-red": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-ansi-red"
              },
              "ansi-bright-red": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-ansi-bright-red"
              },
              "ansi-green": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-ansi-green"
              },
              "ansi-bright-green": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-ansi-bright-green"
              },
              "ansi-yellow": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-ansi-yellow"
              },
              "ansi-bright-yellow": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-ansi-bright-yellow"
              },
              "ansi-blue": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-ansi-blue"
              },
              "ansi-bright-blue": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-ansi-bright-blue"
              },
              "ansi-magenta": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-ansi-magenta"
              },
              "ansi-bright-magenta": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-ansi-bright-magenta"
              },
              "ansi-cyan": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-ansi-cyan"
              },
              "ansi-bright-cyan": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-ansi-bright-cyan"
              },
              "ansi-white": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-ansi-white"
              },
              "ansi-bright-white": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-ansi-bright-white"
              },
              "syntax-keyword": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-syntax-keyword"
              },
              "syntax-string": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-syntax-string"
              },
              "syntax-number": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-syntax-number"
              },
              "syntax-comment": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-syntax-comment"
              },
              "syntax-function": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-syntax-function"
              },
              "syntax-type": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-syntax-type"
              },
              "syntax-variable": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-syntax-variable"
              },
              "syntax-punctuation": {
                "$ref": "#/$defs/color",
                "description": "Sets --skai-syntax-punctuation"
              }
            }
          },
          "gradients": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "canvas": {
                "$ref": "#/$defs/gradient"
              },
              "sidebar": {
                "$ref": "#/$defs/gradient"
              },
              "toolbar": {
                "$ref": "#/$defs/gradient"
              },
              "rail": {
                "$ref": "#/$defs/gradient"
              },
              "composer": {
                "$ref": "#/$defs/gradient"
              },
              "user-bubble": {
                "$ref": "#/$defs/gradient"
              },
              "primary-button": {
                "$ref": "#/$defs/gradient"
              },
              "brand-mark": {
                "$ref": "#/$defs/gradient"
              },
              "empty-state": {
                "$ref": "#/$defs/gradient"
              },
              "backdrop": {
                "$ref": "#/$defs/gradient"
              }
            }
          },
          "fonts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ui": {
                "$ref": "#/$defs/font"
              },
              "heading": {
                "$ref": "#/$defs/font"
              },
              "reading": {
                "$ref": "#/$defs/font"
              },
              "code": {
                "$ref": "#/$defs/font"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "maxLength": 64,
      "description": "#rgb, #rgba, #rrggbb, #rrggbbaa, rgb()/rgba(), hsl()/hsla() with plain numbers, or transparent. Nothing else (no url(), var() or keywords)."
    },
    "gradient": {
      "oneOf": [
        {
          "$ref": "#/$defs/color"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gradient",
            "stops"
          ],
          "properties": {
            "gradient": {
              "enum": [
                "linear",
                "radial",
                "conic"
              ]
            },
            "angle": {
              "type": "number",
              "minimum": 0,
              "maximum": 360,
              "description": "Degrees, for linear and conic. Default 180 (top to bottom)."
            },
            "stops": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "color",
                  "at"
                ],
                "properties": {
                  "color": {
                    "$ref": "#/$defs/color"
                  },
                  "at": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "description": "Up to 4 plain font names, first one wins (letters, digits, space, _ . -).",
          "oneOf": [
            {
              "type": "string",
              "maxLength": 300
            },
            {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9 _.\\-]{0,62}$"
              }
            }
          ]
        },
        "size": {
          "type": "number",
          "minimum": 8,
          "maximum": 32,
          "description": "px"
        },
        "weight": {
          "type": "number",
          "minimum": 100,
          "maximum": 900
        },
        "lineHeight": {
          "type": "number",
          "minimum": 1,
          "maximum": 2.5
        },
        "letterSpacing": {
          "type": "number",
          "minimum": -0.1,
          "maximum": 0.3,
          "description": "em"
        }
      }
    }
  }
}
